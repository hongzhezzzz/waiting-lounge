[
  { "id": "two_sum_brute", "language": "javascript", "code": ["function twoSum(nums, target) {", "  for (let i = 0; i < nums.length; i++) {", "    for (let j = i+1; j < nums.length; j++) {", "      if (nums[i]+nums[j] === target) return [i,j];", "    }", "  }", "  return null;", "}"], "answer": "O(n^2)", "explanation": "Nested loops over n elements: O(n^2)." },
  { "id": "binary_search", "language": "python", "code": ["def bsearch(arr, target):", "    lo, hi = 0, len(arr)-1", "    while lo <= hi:", "        mid = (lo+hi)//2", "        if arr[mid] == target: return mid", "        if arr[mid] < target: lo = mid+1", "        else: hi = mid-1", "    return -1"], "answer": "O(log n)", "explanation": "Each step halves the search space." },
  { "id": "fibonacci_recursive", "language": "python", "code": ["def fib(n):", "    if n <= 1: return n", "    return fib(n-1) + fib(n-2)"], "answer": "O(2^n)", "explanation": "Each call branches into two — exponential without memoization." },
  { "id": "fibonacci_memo", "language": "python", "code": ["from functools import lru_cache", "@lru_cache(None)", "def fib(n):", "    if n <= 1: return n", "    return fib(n-1) + fib(n-2)"], "answer": "O(n)", "explanation": "Memoization caps unique calls at n." },
  { "id": "merge_sort", "language": "python", "code": ["def merge_sort(arr):", "    if len(arr) <= 1: return arr", "    mid = len(arr)//2", "    left = merge_sort(arr[:mid])", "    right = merge_sort(arr[mid:])", "    return merge(left, right)"], "answer": "O(n log n)", "explanation": "Classic divide-and-conquer. log n levels of merge work, O(n) per level." },
  { "id": "single_loop_n", "language": "javascript", "code": ["function sum(nums) {", "  let s = 0;", "  for (const x of nums) s += x;", "  return s;", "}"], "answer": "O(n)", "explanation": "One pass over the array." },
  { "id": "constant_index", "language": "javascript", "code": ["function getFirst(arr) {", "  return arr[0];", "}"], "answer": "O(1)", "explanation": "Direct index access." },
  { "id": "triple_nested", "language": "python", "code": ["def cubed(arr):", "    out = 0", "    for i in arr:", "        for j in arr:", "            for k in arr:", "                out += i*j*k", "    return out"], "answer": "O(n^3)", "explanation": "Three nested loops." },
  { "id": "hash_lookup_loop", "language": "python", "code": ["def hash_count(items, lookup):", "    count = 0", "    for it in items:", "        if it in lookup:", "            count += 1", "    return count"], "answer": "O(n)", "explanation": "Set/dict lookup is O(1) avg; loop dominates." },
  { "id": "tower_of_hanoi", "language": "python", "code": ["def hanoi(n, src, dst, aux):", "    if n == 0: return", "    hanoi(n-1, src, aux, dst)", "    move(src, dst)", "    hanoi(n-1, aux, dst, src)"], "answer": "O(2^n)", "explanation": "T(n) = 2T(n-1) + 1 → 2^n - 1 moves." },
  { "id": "qsort_avg", "language": "python", "code": ["def qsort(arr):", "    if len(arr) <= 1: return arr", "    pivot = arr[len(arr)//2]", "    left = [x for x in arr if x < pivot]", "    mid = [x for x in arr if x == pivot]", "    right = [x for x in arr if x > pivot]", "    return qsort(left) + mid + qsort(right)"], "answer": "O(n log n)", "explanation": "Average case for quicksort. Worst is O(n^2)." },
  { "id": "linear_search", "language": "javascript", "code": ["function find(arr, target) {", "  for (const x of arr) if (x === target) return true;", "  return false;", "}"], "answer": "O(n)", "explanation": "Up to n comparisons." },
  { "id": "matrix_multiply_naive", "language": "python", "code": ["def matmul(A, B):", "    n = len(A)", "    C = [[0]*n for _ in range(n)]", "    for i in range(n):", "        for j in range(n):", "            for k in range(n):", "                C[i][j] += A[i][k]*B[k][j]", "    return C"], "answer": "O(n^3)", "explanation": "Naive triple-loop matmul on n×n matrices." },
  { "id": "log_log_step", "language": "python", "code": ["def f(n):", "    while n > 1:", "        n = n ** 0.5"], "answer": "O(log log n)", "explanation": "Each step takes square root — needs log log n steps to reach 1." },
  { "id": "subset_sum_brute", "language": "python", "code": ["def subsets(arr):", "    out = []", "    for mask in range(1 << len(arr)):", "        sub = [arr[i] for i in range(len(arr)) if mask & (1 << i)]", "        out.append(sub)", "    return out"], "answer": "O(2^n)", "explanation": "Enumerates all 2^n subsets." },
  { "id": "tree_traversal_inorder", "language": "python", "code": ["def inorder(node):", "    if not node: return", "    inorder(node.left)", "    visit(node)", "    inorder(node.right)"], "answer": "O(n)", "explanation": "Visits each of n nodes once." },
  { "id": "constant_time_check", "language": "javascript", "code": ["function isEven(n) {", "  return (n & 1) === 0;", "}"], "answer": "O(1)", "explanation": "Single bitwise op, independent of n." },
  { "id": "kth_smallest_sort", "language": "python", "code": ["def kth(arr, k):", "    arr.sort()", "    return arr[k-1]"], "answer": "O(n log n)", "explanation": "Sort dominates. Quickselect would be O(n) avg but this is sort." },
  { "id": "while_halving", "language": "python", "code": ["def f(n):", "    count = 0", "    while n > 0:", "        count += 1", "        n //= 2", "    return count"], "answer": "O(log n)", "explanation": "Halves n each step." },
  { "id": "double_loop_to_n", "language": "javascript", "code": ["function pairs(n) {", "  let count = 0;", "  for (let i = 0; i < n; i++) {", "    for (let j = i; j < n; j++) {", "      count++;", "    }", "  }", "  return count;", "}"], "answer": "O(n^2)", "explanation": "Triangular ≈ n^2/2 pairs → O(n^2)." },
  { "id": "string_concat_in_loop", "language": "python", "code": ["def s(n):", "    out = ''", "    for i in range(n):", "        out += str(i)", "    return out"], "answer": "O(n^2)", "explanation": "In Python, string concat in a loop is O(n^2) due to repeated copying." },
  { "id": "bfs_graph", "language": "python", "code": ["from collections import deque", "def bfs(graph, start):", "    seen = {start}", "    q = deque([start])", "    while q:", "        n = q.popleft()", "        for nb in graph[n]:", "            if nb not in seen:", "                seen.add(nb)", "                q.append(nb)"], "answer": "O(V + E)", "explanation": "Visits each vertex and edge once. Note: 'O(V+E)' is the canonical answer for graph traversals." },
  { "id": "memo_dp_grid", "language": "python", "code": ["def paths(m, n, memo={}):", "    if (m, n) in memo: return memo[(m, n)]", "    if m == 0 or n == 0: return 1", "    memo[(m, n)] = paths(m-1, n) + paths(m, n-1)", "    return memo[(m, n)]"], "answer": "O(m*n)", "explanation": "Memoized DP fills an m×n table once." },
  { "id": "appending_array", "language": "python", "code": ["def build(n):", "    out = []", "    for i in range(n):", "        out.append(i)", "    return out"], "answer": "O(n)", "explanation": "n appends, each amortized O(1)." },
  { "id": "matrix_search_sorted_rows_cols", "language": "python", "code": ["def find(matrix, target):", "    if not matrix: return False", "    r, c = 0, len(matrix[0]) - 1", "    while r < len(matrix) and c >= 0:", "        if matrix[r][c] == target: return True", "        if matrix[r][c] > target: c -= 1", "        else: r += 1", "    return False"], "answer": "O(m + n)", "explanation": "Staircase search — each step rules out a row or a column." }
]
