PORT=4000
ALLOWED_ORIGINS=http://localhost:3000

# Phase 6+: a Postgres connection string. Required for the board.
# Supabase: copy from Project Settings → Database → Connection string → URI
# (use the "Transaction" pooler string for serverless-safe connections, or
# the direct connection if running on a long-lived backend like Render).
DATABASE_URL=

# Optional: set to "false" to disable SSL for a local Postgres.
# DATABASE_SSL=false
